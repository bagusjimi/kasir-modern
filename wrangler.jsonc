/**
 * For more details on how to configure Wrangler for Cloudflare Pages, refer to:
 * https://developers.cloudflare.com/pages/functions/wrangler-configuration/
 * https://developers.cloudflare.com/pages/framework-guides/deploy-a-svelte-kit-site/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kasir-modern",
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-11-04",
	"compatibility_flags": [
		"nodejs_als"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kasir_modern_db",
			"database_id": "kasir_modern_db_local_or_remote_id"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
